# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Jingle Studio Tools"
NEXT_PUBLIC_WHATSAPP_NUMBER=923138654411

# Database (PostgreSQL in production; omit or use pglite://.pglite for local dev)
DATABASE_URL=pglite://.pglite

# Auth.js (NextAuth v5)
AUTH_SECRET=replace-with-32-byte-random-secret
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private S3-compatible Storage (omit S3_ENDPOINT/S3_BUCKET in dev to use local .storage/)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_OUTPUT_TTL_HOURS=24

# C2PA Signing
# SIGNING_MODE=test uses an ephemeral/self-signed dev certificate and displays the test-signature banner.
# SIGNING_MODE=production uses C2PA_CERT_PEM and C2PA_KEY_PEM (from env or KMS).
SIGNING_MODE=test
C2PA_CERT_PEM=
C2PA_KEY_PEM=
C2PA_TSA_URL=http://timestamp.digicert.com
C2PA_TRUST_LIST_URL=https://raw.githubusercontent.com/c2pa-org/conformance-public/refs/heads/main/trust-list/C2PA-TRUST-LIST.pem

# Credits & Billing
CREDIT_COST_PER_FILE=1
BILLING_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
ADMIN_EMAILS=admin@jinglestudio.io
