# App
NEXT_PUBLIC_APP_URL=https://jinglestudio.io
NEXT_PUBLIC_SITE_NAME="Jingle Studio Tools"
NEXT_PUBLIC_WHATSAPP_NUMBER=923138654411

# Database (PostgreSQL in production)
DATABASE_URL=

# Auth.js v5 & Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=https://jinglestudio.io

# Private S3-compatible Storage (omit S3_ENDPOINT/S3_BUCKET in dev to use local .storage/)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_OUTPUT_TTL_HOURS=24

# C2PA Signing
SIGNING_MODE=test
C2PA_CERT_PEM=
C2PA_KEY_PEM=
C2PA_TSA_URL=http://timestamp.digicert.com
C2PA_TRUST_LIST_URL=https://raw.githubusercontent.com/c2pa-org/conformance-public/refs/heads/main/trust-list/C2PA-TRUST-LIST.pem

# Credits & Billing
CREDIT_COST_PER_FILE=1
BILLING_PROVIDER=manual_bank
PAYMENT_WEBHOOK_SECRET=
ADMIN_EMAILS=admin@jinglestudio.io

# Optional external SynthID Verifier
SYNTHID_VERIFIER_URL=
SYNTHID_VERIFIER_API_KEY=
SYNTHID_VERIFIER_PROVIDER=
